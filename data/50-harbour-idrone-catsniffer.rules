// harbour-idrone: defaultuser darf genau harbour-idrone-catsniffer.service
// starten/stoppen, sonst nichts.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "harbour-idrone-catsniffer.service" &&
        subject.user == "defaultuser") {
        return polkit.Result.YES;
    }
});
